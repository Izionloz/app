+                if (u_ledP.z > 0.5) { lc = u_ledP.z > 1.5 ? vec3(0.55, 0.75, 1.0) : vec3(1.0, 0.16, 0.16); on = true; }
+                c = over(c, on ? lc : lc * 0.2, cover);
+            }
+        }
+    }
+    if (u_stripe.z > 0.0) {
+        vec2 q = p - u_stripe.xy;
+        if (q.x >= 0.0 && q.y >= 0.0 && q.x <= u_stripe.z && q.y <= u_stripe.w) {
+            if (mod(q.x + q.y * 0.85, 20.0) < 13.0) c = over(c, u_pal[0].rgb * 1.25, 1.0);
+        }
+    }
+    gl_FragColor = vec4(c, 1.0);
+}
+`;
+
+const EVADASH2 = `// The EVA Comfort cluster's whole backdrop in one cluster-render "effect" layer (GLSL ES 1.00): black, up to 12 framed or ruled
+// rects from the layout (u_frame x, y, w, h in layer px; u_fstyle chamfer px, border px, kind, colour), two segmented
+// rails (u_rail geometry; u_railP segments, lit segments, gap px, kind; u_railCol lit colour and brightness) and one
+// hatched stripe (u_stripe). kind 0: a chamfered outline; 1: side lines and a bottom line only; 2: a solid rule.
+// kind of a rail 0: every lit segment in u_railCol; 1: the coolant ramp (mint, amber from 21/24 = 105 C, red at the last segment).
+// v_uv (0,0) is the top-left.
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+varying vec2 v_uv;
+uniform vec2 u_size;
+uniform float u_n;
+uniform vec4 u_frame[8];
+uniform vec4 u_fstyle[8];
+uniform vec4 u_fcut[8];  // the corner cuts px: top-left, top-right, bottom-right, bottom-left
+uniform vec4 u_pal[3];
+uniform vec4 u_rail[2];
+uniform vec4 u_railP[2];
+uniform vec4 u_railCol[2];
+uniform vec4 u_off;
+uniform vec4 u_stripe;
+uniform vec4 u_led;      // the shift lights: x, y, w, h in layer px (w 0: none)
+uniform vec4 u_ledP;     // count, lit, strobe (0 none, 1 red, 2 white-blue), tail (the last lights are blue)
+uniform vec4 u_fx;       // the rev rail's effects: sweep phase 0..1, pulse 0..1, level 0..3, the redline as a part of the rail
+uniform vec4 u_hole;     // a see-through rounded hole (x, y, w, h in layer px, w 0: none) for BMW's map
+uniform float u_holeR;
+uniform float u_bgA;     // the backdrop's opacity: 1 black, 0 only what is drawn shows (a second layer of frames)
+
+float cham(vec2 p, vec4 r, vec4 c) {
+    vec2 h = r.zw * 0.5;
+    vec2 q = abs(p - (r.xy + h)) - h;
+    vec2 a = p - r.xy;
+    vec2 b = r.zw - a;
+    float d = max(q.x, q.y);
+    d = max(d, (c.x - (a.x + a.y)) * 0.70710678);
+    d = max(d, (c.y - (b.x + a.y)) * 0.70710678);
+    d = max(d, (c.z - (b.x + b.y)) * 0.70710678);
+    d = max(d, (c.w - (a.x + b.y)) * 0.70710678);
+    return d;
+}
+
+vec3 over(vec3 under, vec3 c, float a) { return mix(under, c, clamp(a, 0.0, 1.0)); }
+
+vec4 rail(vec2 p, vec4 r, vec4 sp, vec4 cl) {
+    vec2 q = p - r.xy;
+    if (q.x < 0.0 || q.y < 0.0 || q.x > r.z || q.y > r.w) return vec4(0.0);
+    bool rev = sp.w < 0.5;
+    bool ramp = sp.w > 0.5 && sp.w < 1.5;
+    float edge = min(min(q.x, r.z - q.x), min(q.y, r.w - q.y));
+    if (edge < 1.0) {
+        vec3 b = vec3(0.6, 0.2, 0.16);
+        if (rev) b = mix(b, cl.rgb, clamp(0.18 * u_fx.z + 0.6 * u_fx.y, 0.0, 1.0));
+        return vec4(b, 1.0);
+    }
+    float pad = 5.0;
+    vec2 s = vec2(q.x - pad, q.y - pad);
+    float n = sp.x, gap = sp.z;
+    float slot = (r.z - 2.0 * pad + gap) / n;
+    float i = floor(s.x / slot);
+    float fx = s.x - i * slot;
+    float inY = clamp(s.y + 0.5, 0.0, 1.0) * clamp(r.w - 2.0 * pad - s.y + 0.5, 0.0, 1.0);
+    float a = clamp(fx + 0.5, 0.0, 1.0) * clamp(slot - gap - fx + 0.5, 0.0, 1.0) * inY;
+    if (i < 0.0 || i >= n || a <= 0.0) return vec4(0.04, 0.0, 0.01, 1.0);
+    float fy = s.y / (r.w - 2.0 * pad);
+    float k = i / n;
+    vec3 col = u_off.rgb;
+    if (rev) {
+        // the zones are marked on the unlit segments: warm before the redline, red from it
+        if (k >= u_fx.w) col = vec3(0.46, 0.06, 0.09);
+        else if (k >= u_fx.w - 0.2) col = vec3(0.30, 0.10, 0.06);
+    }
+    if (i < sp.y) {
+        vec3 c = cl.rgb;
+        if (ramp) {
+            c = k >= 0.9500 ? vec3(0.98, 0.32, 0.30) : (k >= 0.8700 ? vec3(0.98, 0.74, 0.41) : vec3(0.40, 0.96, 0.72));
+        }
+        if (rev) {
+            float d = (sp.y - 1.0) - i;                       // how far behind the head: 0 at the last lit segment
+            c *= clamp(1.0 - d * 0.035, 0.6, 1.0);            // brighter towards the head
+            c = mix(c, vec3(1.0, 0.96, 0.82), 0.6 * (1.0 - clamp(d, 0.0, 1.0)));      // the head is white-hot
+            float sw = fract(u_fx.x) * (sp.y + 6.0) - 3.0;    // a bright band runs along the lit part
+            c += vec3(0.38, 0.30, 0.18) * clamp(1.0 - abs(i - sw) * 0.4, 0.0, 1.0) * step(0.5, u_fx.z);
+            c = mix(c, vec3(1.0, 0.12, 0.2), u_fx.y * 0.6 * step(1.5, u_fx.z));       // the redline strobe
+            // the last lit segments strobe on their own from the second level on (shift lights)
+            c = mix(c, vec3(1.0, 0.95, 0.8), step(1.5, u_fx.z) * u_fx.y * step(sp.y - 6.0, i) * 0.45);
+        }
+        col = mix(c * 1.18, c * 0.92, fy) * cl.a;
+    }
+    return vec4(col, a);
+}
+
+void main() {
+    vec2 p = v_uv * u_size;
+    vec3 c = vec3(0.0);
+    for (int i = 0; i < 8; i++) {
+        if (float(i) >= u_n) break;
+        vec4 r = u_frame[i];
+        vec4 st = u_fstyle[i];
+        vec4 col = u_pal[0];
+        float gl = floor(st.w / 4.0);
+        float ci = st.w - 4.0 * gl;
+        if (ci > 1.5) col = u_pal[2]; else if (ci > 0.5) col = u_pal[1];
+        float a = 0.0;
+        float glow = 0.0;
+        if (st.z < 0.5) {
+            float d = cham(p, r, u_fcut[i]);
+            float e = abs(d + 0.5 * st.y) - 0.5 * st.y;
+            a = clamp(0.5 - e, 0.0, 1.0);
+            glow = gl * 0.16 * exp(-abs(d) / 7.0);
+        } else if (st.z < 1.5) {
+            vec2 q = p - r.xy;
+            if (q.x >= 0.0 && q.y >= 0.0 && q.x <= r.z && q.y <= r.w) {
+                if (q.x < st.y || r.z - q.x < st.y || r.w - q.y < 3.0) a = 1.0;
+            }
+        } else if (st.z < 2.5) {
+            vec2 q = p - r.xy;
+            if (q.x >= 0.0 && q.y >= 0.0 && q.x <= r.z && q.y <= r.w) a = 1.0;
+        } else {
+            // a slanted rule from the rect's bottom-left to its top-right corner, st.y px thick
+            vec2 q = p - r.xy;
+            if (q.x >= 0.0 && q.y >= 0.0 && q.x <= r.z && q.y <= r.w) {
+                float dd = abs(q.x * r.w + q.y * r.z - r.z * r.w) / length(vec2(r.w, r.z));
+                a = clamp(0.5 * st.y + 0.5 - dd, 0.0, 1.0);
+            }
+        }
+        c = over(c, col.rgb, a * col.a);
+        c += col.rgb * glow * col.a * (1.0 - a);
+    }
+    for (int k = 0; k < 2; k++) {
+        vec4 rr = rail(p, u_rail[k], u_railP[k], u_railCol[k]);
+        c = over(c, rr.rgb, rr.a);
+        if (k == 0 && u_railP[0].w < 0.5 && rr.a == 0.0) {
+            // a glow round the rev rail that grows with the level and breathes at the redline
+            vec4 r = u_rail[0];
+            vec2 h = r.zw * 0.5;
+            vec2 d2 = abs(p - (r.xy + h)) - h;
+            float d = length(max(d2, 0.0));
+            float g = exp(-d / 6.0) * (0.10 * u_fx.z + 0.6 * u_fx.y) * u_railCol[0].a;
+            c += u_railCol[0].rgb * g * step(0.5, u_fx.z);
+        }
+    }
+    if (u_led.z > 0.0) {
+        vec2 q = p - u_led.xy;
+        if (q.x >= 0.0 && q.y >= 0.0 && q.x <= u_led.z && q.y <= u_led.w) {
+            float n = u_ledP.x;
+            float slot = (u_led.z + 6.0) / n;
+            float idx = floor(q.x / slot);
+            float inSeg = q.x - idx * slot;
+            float segW = slot - 6.0;
+            if (inSeg <= segW && idx < n) {
+                vec2 hs = vec2(segW, u_led.w) * 0.5;
+                float rr = min(4.0, hs.y);
+                vec2 qq = abs(vec2(inSeg, q.y) - hs) - (hs - vec2(rr));
+                float d = length(max(qq, 0.0)) + min(max(qq.x, qq.y), 0.0) - rr;
+                float cover = clamp(0.5 - d, 0.0, 1.0);
+                float nMain = max(1.0, n - u_ledP.w);
+                float f = idx / max(1.0, nMain - 1.0);
+                vec3 lc = idx >= nMain ? vec3(0.16, 0.49, 1.0) : (f < 0.42 ? vec3(0.18, 0.82, 0.48) : (f < 0.75 ? vec3(1.0, 0.76, 0.10) : vec3(1.0, 0.16, 0.16)));
+                bool on = idx < u_ledP.y;
+                if (u_ledP.z > 0.5) { lc = u_ledP.z > 1.5 ? vec3(0.55, 0.75, 1.0) : vec3(1.0, 0.16, 0.16); on = true; }
+                c = over(c, on ? lc : lc * 0.2, cover);
+            }
+        }
+    }
+    if (u_stripe.z > 0.0) {
+        vec2 q = p - u_stripe.xy;
+        if (q.x >= 0.0 && q.y >= 0.0 && q.x <= u_stripe.z && q.y <= u_stripe.w) {
+            if (mod(q.x + q.y * 0.85, 20.0) < 13.0) c = over(c, u_pal[0].rgb * 1.25, 1.0);
+        }
+    }
+    float back = u_bgA;
+    if (u_hole.z > 0.0) {
+        vec2 hs = u_hole.zw * 0.5;
+        vec2 q = abs(p - (u_hole.xy + hs)) - (hs - vec2(u_holeR));
+        float hd = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - u_holeR;
+        back *= clamp(hd + 0.5, 0.0, 1.0);
+    }
+    float ink = clamp(max(c.r, max(c.g, c.b)) * 6.0, 0.0, 1.0);
+    gl_FragColor = vec4(c, max(back, ink));
+}
+`;
+
+
+const EVADIAL = `// The V12-style cluster's round rev counter in one cluster-render "effect" layer (GLSL ES 1.00): an open ring with a track, a lit part
+// (yellow, red from the red zone on), a red band outside the zone, tick marks inside the ring, a row of shift dots round the top and a thin
+// circle line for the map window in the middle. Straight alpha, transparent elsewhere. v_uv (0,0) is the top-left.
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+varying vec2 v_uv;
+uniform vec2 u_size;
+uniform vec4 u_c;     // centre x, y (layer px), ring radius, ring width
+uniform vec4 u_a;     // start angle (rad, clockwise from 12 o'clock), sweep, value 0..1, red zone start 0..1
+uniform vec4 u_t;     // tick intervals, minor ticks per interval, major length, minor length (px)
+uniform vec4 u_led;   // shift dots: radius from the centre, dot radius, count, lit (0 none)
+uniform vec4 u_fx;    // strobe 0 / 1 / 2, wings 0 / 1 (the shift dots fill from both ends), the dish's lower clip (px under the centre, 0 = by the layer), pulse 0..1
+uniform vec4 u_n;     // the needle: inner radius, outer radius, width px, on (1)
+uniform vec4 u_w;     // the light effects: warp strength 0..1, time (s), the shift flash 0..1, the redline glow 0..1
+uniform vec3 u_yel;
+uniform vec3 u_red;
+uniform vec2 u_o;       // the warp streaks' origin in layer px (0: the dial's centre)
+uniform float u_bg;     // 1: the layer paints the whole cluster black under everything it draws
+uniform float u_whole;      // 1: the layer is the whole cluster: the vignette and the stars are drawn
+uniform float u_flat;   // 1: a flat look: no dish, bezel, vignette, stars, tube shading, glow or shadows (the windshield HUD: black is no light there)
+const float PI = 3.14159265359;
+
+float arcDist(vec2 p, float r, float a0, float s) {
+    float a = atan(p.x, -p.y);
+    float rel = mod(a - a0 + 4.0 * PI, 2.0 * PI);
+    if (rel <= s) return abs(length(p) - r);
+    vec2 e0 = r * vec2(sin(a0), -cos(a0));
+    vec2 e1 = r * vec2(sin(a0 + s), -cos(a0 + s));
+    return min(length(p - e0), length(p - e1));
+}
+
+vec4 ov(vec4 acc, vec3 c, float a) {
+    a = clamp(a, 0.0, 1.0);
+    float oa = a + acc.a * (1.0 - a);
+    vec3 rgb = (c * a + acc.rgb * acc.a * (1.0 - a)) / max(oa, 0.0001);
+    return vec4(rgb, oa);
+}
+
+void main() {
+    vec2 p = v_uv * u_size - u_c.xy;
+    float d = length(p);
+    float r = u_c.z, hw = u_c.w * 0.5;
+    float a = atan(p.x, -p.y);
+    float rel = mod(a - u_a.x + 4.0 * PI, 2.0 * PI);
+    float f = rel / u_a.y;
+    float redAt = u_a.w;
+    float Rf = r + hw + 24.0;                       // the face: a dark dish with a sheen of glass over it
+    float flatHud = (u_flat > 0.5 && u_flat < 2.5) ? 1.0 : 0.0;     // flat 1 and 2: the HUD looks; 3 keeps the glow, the stars and the vignette
+    vec4 acc = vec4(0.0, 0.0, 0.0, u_bg);
+    vec2 pos = v_uv * u_size;
+    // the screen's edges fall away a little (a vignette), and glow red at the redline
+    float vg = smoothstep(0.50, 1.10, length((v_uv - 0.5) * vec2(1.25, 1.0) * 2.0));
+    if (flatHud < 0.5 && u_whole > 0.5 && u_w.y >= 0.0) acc = ov(acc, vec3(0.0), 0.32 * vg);
+    if (flatHud < 0.5 && u_whole > 0.5) acc = ov(acc, u_red, u_w.w * 0.42 * smoothstep(0.35, 1.15, length((v_uv - 0.5) * vec2(1.25, 1.0) * 2.0)));
+    // a field of faint stars far back, drifting slowly (they stretch into the warp streaks above a certain speed)
+    if (flatHud < 0.5 && u_whole > 0.5 && u_w.y >= 0.0 && d > r + hw + 30.0) {
+        vec2 sp = pos + vec2(0.0, u_w.y * 5.0);
+        vec2 cell = floor(sp / 28.0);
+        float hh = fract(sin(dot(cell, vec2(12.9898, 78.233))) * 43758.5453);
+        if (hh < 0.10) {
+            vec2 ctr = (cell + vec2(fract(hh * 91.7), fract(hh * 37.3))) * 28.0;
+            float tw = 0.5 + 0.5 * sin(u_w.y * (1.0 + 3.0 * fract(hh * 53.1)) + hh * 60.0);
+            float st = clamp(1.0 - length(sp - ctr) / (1.2 + 1.6 * fract(hh * 17.9)), 0.0, 1.0);
+            acc = ov(acc, vec3(0.8, 0.88, 1.0), 0.55 * st * (0.35 + 0.65 * tw));
+        }
+    }
+    float cutLim = u_fx.z > 0.0 ? u_fx.z : (u_size.y - u_c.y - 84.0);
+    float cut = clamp(cutLim - p.y, 0.0, 1.0);   // the dish and the bezel end 84 px over the layer's bottom: the bottom row is there
+    if (u_flat < 0.5 && d < Rf + 1.0) {
+        float tt = d / Rf;
+        vec3 face = mix(vec3(0.060, 0.062, 0.072), vec3(0.006, 0.006, 0.009), smoothstep(0.0, 1.0, tt));
+        float sheen = 0.075 * smoothstep(-0.25, 0.95, -p.y / Rf) * (1.0 - 0.45 * tt);
+        float streak = 0.035 * smoothstep(0.55, 0.0, abs((p.x + p.y * 0.6) / Rf + 0.28));   // a soft diagonal reflection
+        face += vec3(sheen + streak);
+        acc = ov(acc, face, clamp(Rf + 0.5 - d, 0.0, 1.0) * cut);
+        // the dish is deeper by the ring: a shadow on its inner side
+        float sh = smoothstep(r - hw - 40.0, r - hw, d) * (1.0 - smoothstep(r - hw, r - hw + 3.0, d));
+        acc = ov(acc, vec3(0.0), 0.6 * sh * cut);
+    }
+    // the warp: light streaks fly out of the middle, over the ring and on to the edges of the whole cluster, while the car accelerates,
+    // as in a jump to light speed. Thin lines of a few px, so they look alike near the middle and at the far edge
+    if (u_w.x > 0.01) {
+        vec2 qo = u_o.x > 0.0 ? pos - u_o : p;
+        float d0 = length(qo);
+        float ao = atan(qo.x, -qo.y);
+        float N = 200.0;
+        float sl = ao / (2.0 * PI) * N + N * 0.5;
+        float i = floor(sl);
+        float fr = fract(sl);
+        float h1 = fract(sin(i * 12.9898) * 43758.5453);
+        float h2 = fract(sin(i * 78.233 + 1.7) * 12345.6789);
+        float h3 = fract(sin(i * 39.346 + 5.1) * 9876.5432);
+        if (h1 < 0.18 + 0.7 * u_w.x) {
+            float R0 = r - hw;
+            float ph = fract(h3 + u_w.y * (0.22 + 0.8 * h2));
+            float rad = d0 / R0;
+            float len = (0.22 + 0.9 * u_w.x) * (0.6 + h2);
+            float t = (ph * 4.6 - rad) / len;
+            float body = (t > 0.0 && t < 1.0) ? (1.0 - t) : 0.0;
+            float perpPx = abs(fr - 0.5) * (2.0 * PI * d0 / N);
+            float wpx = 1.2 + 2.2 * u_w.x * h2;
+            float side = 1.0 - smoothstep(0.3 * wpx, wpx, perpPx);
+            float vis = (flatHud > 0.5 ? smoothstep(1.0, 1.3, rad) : smoothstep(0.28, 0.9, rad)) * (1.0 - smoothstep(3.4, 4.2, rad));   // flat (the HUD): only outside the ring, the speed stays clear
+            float edge = min(min(pos.x, u_size.x - pos.x), min(pos.y, u_size.y - pos.y));
+            float outer = (d0 > r + hw + 24.0 ? 0.65 : 1.0) * (u_o.x > 0.0 ? 0.8 : 1.0) * (u_whole > 0.5 ? 1.0 : smoothstep(0.0, 60.0, edge));                       // a little fainter out over the panels, so their words stay clear
+            acc = ov(acc, mix(vec3(0.78, 0.9, 1.0), u_yel, 0.22), clamp(body * side * vis * outer * (0.45 + u_w.x) * 1.5, 0.0, 1.0));
+        }
+    }
+    // the chrome bezel round the face: bright and dark stretches follow the light
+    float rb = r + hw + 18.0, bw = 8.0;
+    float bd = abs(d - rb) - bw * 0.5;
+    if (u_flat < 0.5 && bd < 1.0) {
+        float m = 0.20 + 0.55 * pow(0.5 + 0.5 * cos(2.0 * (a - 0.9 + 0.5 * u_a.z)), 4.0) + 0.40 * pow(0.5 + 0.5 * cos(a + 2.3), 10.0);
+        float across = clamp((d - (rb - bw * 0.5)) / bw, 0.0, 1.0);
+        m *= 0.55 + 0.75 * sin(PI * across);
+        acc = ov(acc, vec3(m * 0.94, m * 0.96, m), clamp(0.5 - bd, 0.0, 1.0) * cut);
+    }
+    // the red band outside the ring, over the red zone
+    float bandD = arcDist(p, r + hw + 8.0, u_a.x + u_a.y * redAt, u_a.y * (1.0 - redAt)) - 2.0;
+    acc = ov(acc, u_red, 0.85 * clamp(0.5 - bandD, 0.0, 1.0));
+    // the ring: the track, then the lit part, with a glow round it
+    float ringD = arcDist(p, r, u_a.x, u_a.y) - hw;
+    float lit = u_a.z * u_a.y;
+    // the lit part ends square, right at the needle (a round cap would reach past it by half the ring's width)
+    float litD = 1e5;
+    if (lit > 0.002) {
+        float gapMid = lit + (2.0 * PI - lit) * 0.5;
+        float relS = rel > gapMid ? rel - 2.0 * PI : rel;
+        litD = max(abs(d - r) - hw, max(-relS, relS - lit) * d);
+    }
+    bool zone = f >= redAt && f <= 1.0;
+    vec3 track = zone ? vec3(0.30, 0.04, 0.04) : vec3(0.15, 0.15, 0.17);
+    vec3 litC = zone ? u_red : u_yel;
+    float pulse = u_fx.w;
