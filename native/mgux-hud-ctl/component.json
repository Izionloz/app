{
  "id": "mgux-hud-ctl",
  "kind": "tool",
  "version": "2.8.0",
  "title": "HUD map settings",
  "description": "Beside waze-on-cluster 0.9.0's own app: sits between waze-on-cluster and cluster-render and adds brightness, zoom with a focus and rotation to its HUD and cluster maps, and the cluster map's place and size; the HUD map app talks to it",
  "files": [
    {
      "path": "hudctl.js",
      "mode": "0644"
    },
    {
      "path": "renderproxy.js",
      "mode": "0644"
    },
    {
      "path": "wazestatus.js",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "mgux-hud-ctl.service"
    }
  ],
  "dropins": [
    {
      "unit": "waze-on-cluster.service",
      "name": "zz-mgux-hud-ctl.conf"
    }
  ],
  "enable": [
    {
      "unit": "mgux-hud-ctl.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "mgux-hud-ctl"
  ],
  "restart": [
    "mgux-hud-ctl.service"
  ],
  "mguHmi": [
    "ID7"
  ]
}
