{
  "id": "mgux-hud-ctl",
  "kind": "tool",
  "version": "2.18.1",
  "title": "HUD map settings",
  "description": "Puts the CarPlay map on the cluster, the HUD or both and keeps its size, place, brightness, soft edges, zoom and rotation, between waze-on-cluster and cluster-render; with waze-on-cluster 0.9.0 it works beside its own app; the HUD map app talks to it",
  "files": [
    {
      "path": "hudctl.js",
      "mode": "0644"
    },
    {
      "path": "renderproxy.js",
      "mode": "0644"
    },
    {
      "path": "wazestatus.js",
      "mode": "0644"
    },
    {
      "path": "wazecontrol.js",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "mgux-hud-ctl.service"
    }
  ],
  "dropins": [
    {
      "unit": "waze-on-cluster.service",
      "name": "zz-mgux-hud-ctl.conf"
    }
  ],
  "enable": [
    {
      "unit": "mgux-hud-ctl.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "mgux-hud-ctl"
  ],
  "restart": [
    "mgux-hud-ctl.service"
  ],
  "mguHmi": [
    "ID7"
  ]
}
